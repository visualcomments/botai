# Student-owned material of an INSTALLED workspace. Anchored to this
# repository's root on purpose: an unanchored `progress/` also matches
# `examples/legacy-course/progress/`, which is a test fixture that must be
# committed — a local run would pass while CI failed on the missing file.
/courses/
/progress/
/dist/

__pycache__/
*.py[cod]

# Private runtime state of an installed workspace: install record, backups of
# locally edited files, the local database and caches. A developer checkout
# normally has none of this, but an in-place install or update would otherwise
# create it inside the source tree and invite an accidental commit.
/.botai/

# Local environments.
/.venv/
/venv/
/.core-venv/

# Secrets and machine-local configuration.
.env
.env.*
!.env.example
